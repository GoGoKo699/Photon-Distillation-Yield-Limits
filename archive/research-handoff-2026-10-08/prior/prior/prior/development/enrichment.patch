+def gaussian_fock_mask4(eta: Fraction, mask: int, common_bad: bool=False):
+    """Independent exact check: unnormalized creation polynomials over Z[i].
+
+    Fourier phases are fourth roots of unity. Row weights and Fock factorials
+    are applied only after the integer polynomial is expanded. eta is rational.
+    """
+    n=4; modes=5
+    labels=[(1 if common_bad else j+1) if mask>>j&1 else 0 for j in range(n)]
+    d=max(labels)+1
+    state={(0,)*(modes*d):(1,0)}
+    roots=((1,0),(0,1),(-1,0),(0,-1))
+    for j,lab in enumerate(labels):
+        nxt={}
+        for occ,(ar,ai) in state.items():
+            for row in range(modes):
+                phase=(row*j)%4 if row<4 else 0
+                cr,ci=roots[phase]
+                key=list(occ);key[row*d+lab]+=1;key=tuple(key)
+                br,bi=nxt.get(key,(0,0))
+                nxt[key]=(br+ar*cr-ai*ci,bi+ar*ci+ai*cr)
+        state=nxt
+    norm=Fraction(0); h=Fraction(0); bad=Fraction(0)
+    for occ,(ar,ai) in state.items():
+        spatial=[sum(occ[row*d:(row+1)*d]) for row in range(modes)]
+        weight=Fraction((ar*ar+ai*ai)*math.prod(math.factorial(k) for k in occ),4**4)
+        weight*=eta**spatial[0]*(1-eta)**spatial[4]
+        norm+=weight
+        if spatial[0]==1 and sum(row*spatial[row] for row in range(1,4))%4==0:
+            h+=weight
+            if sum(occ[1:d])==1:bad+=weight
+    return norm,h,bad
 
 
